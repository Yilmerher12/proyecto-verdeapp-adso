# ==============================================================================
# ♻️ VerdeApp — Variables de Entorno del Backend (Plantilla)
# ==============================================================================
# INSTRUCCIONES:
#   1. Copiar: cp .env.example .env
#   2. Con Docker Compose no necesitas editar nada — funciona con estos valores. Aunque se debe generar un SECRET_KEY propio (ver más abajo).
#   3. NUNCA se debe subir el .env real al repositorio (.gitignore ya lo protege).
# ==============================================================================

# ── Base de datos (PostgreSQL 17) ──────────────────────────────────────────────
# En Docker: host = nombre del servicio (verde_db), puerto interno = 5432
# En local sin Docker: cambiar @verde_db:5432 por @localhost:5433
DATABASE_URL=postgresql://verde_user:verde_password@verde_db:5432/verdeapp_db

# ── Seguridad JWT ──────────────────────────────────────────────────────────────
# ⚠️ OBLIGATORIO: reemplaza el valor de abajo por el que se genere antes de arrancar.
# El valor de ejemplo es intencionalmente corto — el backend exige mínimo 32
# caracteres (be/app/config.py), así que si se olvidas cambiarlo, la app no arranca
# en vez de arrancar en silencio con una clave que cualquiera con este repo conoce.
# Generar la propia con: python -c "import secrets; print(secrets.token_hex(32))"
# Otra opcion sin python instalado sino git: openssl rand -hex 32
# Nunca se sube el valor real a Git — cada persona/entorno genera el suyo propio.
SECRET_KEY=reemplaza-esto-por-tu-propia-clave
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Correo (Mailpit — desarrollo local) ───────────────────────────────────────
# En Docker: SMTP_HOST = nombre del servicio (verde_mailpit)
# En local sin Docker: SMTP_HOST=localhost
# UI de Mailpit disponible en: http://localhost:8025
# Si SMTP_HOST está vacío, se usa Resend (más abajo) en su lugar.
SMTP_HOST=verde_mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Correo (Resend — alternativa para producción) ─────────────────────────────
# Solo se usa si SMTP_HOST está vacío. Si ambos están vacíos, los emails no se
# envían de verdad — solo quedan registrados en los logs del servidor.
# Obtener API key en: https://resend.com/api-keys (capa gratuita: 3,000/mes).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=VerdeApp

# ── Frontend ───────────────────────────────────────────────────────────────────
# Docker (modo demo/sustentación): http://localhost:3000
# Desarrollo local (pnpm dev):     http://localhost:5173
FRONTEND_URL=http://localhost:3000

# ── Entorno ────────────────────────────────────────────────────────────────────
# development → Swagger UI activo en http://localhost:8000/docs
# production  → Swagger desactivado
ENVIRONMENT=development